; Engine configuration file.
; Dopamine — Goal 01 graybox combat prototype

config_version=5

[application]
config/name="Dopamine"
run/main_scene="res://scenes/Main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
next_wave={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
speed_1={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
speed_2={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
speed_3={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies"
